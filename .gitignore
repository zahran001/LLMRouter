# --- Rust ---
target/
# Cargo.lock is kept in version control since router/ is a binary crate.

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Env files ---
.env
.env.*
!.env.example

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Local tool config ---
.claude/

# --- GPU session state ---
# Written by scripts/gpu_session/create_instance.sh, read by
# teardown_week2.sh so teardown targets the instance/zone actually
# created. Ignored deliberately: `run_on_instance.sh bootstrap` refuses a
# dirty tree, so standing up an instance must not dirty it.
.gpu_session_target

# --- Benchmark artifacts ---
# Explicit split (see benchmarks/README.md, "What is committed and what is not").
# Tracked, because published claims have to be reproducible from them:
#   benchmarks/schedules/    frozen workload INPUTS (replay's source of truth, §5)
#   benchmarks/calibration/  the evidence behind every resolved [CALIBRATE] value
#   benchmarks/evidence/     accepted results supporting BASELINE.md
# Ignored, because they are working output rather than evidence:
benchmarks/scratch/
benchmarks/runs/
# Raw per-request logs are large and are scratch by default. Promoting a
# point into benchmarks/evidence/ is the deliberate act that makes it
# evidence -- so the negation below is scoped to that subtree only.
benchmarks/**/*.raw_log.jsonl
benchmarks/**/*.samples.jsonl
!benchmarks/evidence/**/*.raw_log.jsonl
!benchmarks/evidence/**/*.samples.jsonl

# Verified tokenizer files fetched by scripts/fetch_tokenizer.py for the R4B
# capacity check. A 9MB build input, not evidence -- the hash proof that it is
# the pinned model's tokenizer lives in its PROVENANCE.json, which is what
# makes re-fetching cheap and committing it pointless.
.tokenizer_cache/

# Verified config.json fetched by scripts/fetch_model_config.py (Week 3 cost
# model). Same rationale as .tokenizer_cache/: a build input, not evidence --
# the hash proof lives in PROVENANCE.json and in the derived
# benchmarks/workloads/week3_cost/request_cost_provenance.v1.json, which IS
# committed.
.model_config_cache/
