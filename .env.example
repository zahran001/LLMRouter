# Port the router's HTTP server listens on.
ROUTER_PORT=8080

# REQUIRED. Base URL of the single upstream the Week 1 router proxies to.
# No default exists in code: the mock -> vLLM swap is a config change, not a
# code change (WEEK1_ROUTER_IMPL.md decision 6), so the router refuses to
# start if this is unset. Point it at the mock in dev, at a vLLM replica on
# the GPU box.
UPSTREAM_BASE_URL=http://127.0.0.1:9001

# Comma-separated list of vLLM replica base URLs the router will proxy to.
# Multi-replica routing is Week 2+; Week 1 uses UPSTREAM_BASE_URL only.
REPLICA_URLS=http://localhost:9001,http://localhost:9002

# Time-to-first-token SLO, in milliseconds.
SLO_TTFT_MS=500
